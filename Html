<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nix - Mujer Águila</title>

    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background-color: #eaf4ff;
        }

        header {
            background-color: #0066cc;
            color: white;
            padding: 20px;
        }

        .logo {
            color: white;
            font-size: 30px;
            font-weight: bold;
        }

        nav a {
            color: white;
            margin: 15px;
            text-decoration: none;
        }

        main {
            padding: 30px;
            text-align: center;
        }

        img {
            width: 300px;
            border-radius: 10px;
        }

        button {
            background-color: #0066cc;
            color: white;
            border: none;
            padding: 12px 20px;
            border-radius: 5px;
        }

        input {
            padding: 10px;
            margin: 5px;
        }

        footer {
            background-color: #003366;
            color: white;
            text-align: center;
            padding: 15px;
        }
    </style>
</head>

<body>

    <!-- Encabezado -->
    <header>
        <div class="logo">NIX 🦅</div>

        <!-- Menú -->
        <nav>
            <a href="#inicio">Inicio</a>
            <a href="#historia">Historia</a>
            <a href="#contacto">Contacto</a>
        </nav>
    </header>

    <!-- Contenido -->
    <main id="inicio">

        <h1>Nix, la Mujer Águila</h1>

        <p>
            Nix es una mujer fuerte y valiente que representa
            la libertad, la fuerza y el poder del águila.
        </p>

        <!-- Foto -->
        <img 
            src="https://placehold.co/500x350/0066cc/ffffff?text=NIX+%C3%81GUILA"
            alt="Nix, mujer águila"
        >

        <h2 id="historia">La historia de Nix</h2>

        <p>
            Nix tiene la capacidad de volar y proteger a quienes lo necesitan.
        </p>

        <!-- Botón -->
        <button onclick="alert('Conoce la historia de Nix')">
            Conocer más
        </button>

        <!-- Formulario -->
        <section id="contacto">
            <h2>Contacto</h2>

            <form onsubmit="alert('Formulario enviado'); return false;">
                <input type="text" placeholder="Tu nombre" required>
                <input type="email" placeholder="Tu correo" required>
                <button type="submit">Enviar</button>
            </form>
        </section>

    </main>

    <!-- Pie de página -->
    <footer>
        <p>© 2026 Nix - Mujer Águila</p>
    </footer>

</body>
</html>